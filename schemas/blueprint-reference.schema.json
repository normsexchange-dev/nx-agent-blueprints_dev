{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://raw.githubusercontent.com/normsexchange-dev/nx-agent-blueprints_dev/blueprints-v0.2.0/schemas/blueprint-reference.schema.json",
  "title": "Exact pairwise blueprint publication reference", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "purpose", "publisher_owner", "publisher_repository", "commit", "package_path", "annotated_tag", "tag_object", "tag_target", "package_digest", "family_id", "family_version", "provenance", "receiver_action"],
  "properties": {"schema_version": {"const": "1.0.0"}, "purpose": {"enum": ["blueprint_available", "blueprint_update_proposed", "learning_proposal_shared", "evaluation_result_shared", "blueprint_fork_notice", "deprecation_notice", "retirement_notice"]}, "publisher_owner": {"type": "string"}, "publisher_repository": {"type": "string"}, "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "package_path": {"type": "string"}, "annotated_tag": {"type": "string"}, "tag_object": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "tag_target": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "package_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "family_id": {"type": "string"}, "family_version": {"type": "string"}, "provenance": {"type": "array", "minItems": 1}, "receiver_action": {"enum": ["evaluate_only", "adopt", "reject", "fork"]}}
}
