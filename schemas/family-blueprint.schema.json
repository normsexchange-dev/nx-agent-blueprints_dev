{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/normsexchange-dev/nx-agent-blueprints_dev/blueprints-v0.1.1/schemas/family-blueprint.schema.json",
  "title": "NX agent-family blueprint manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "family_id", "family_title", "owning_environment", "publisher", "family_version", "lifecycle_state", "purpose", "nonpurpose", "parent", "compatibility", "supported_runtime_families", "input_types", "output_types", "required_provenance", "tools", "declared_capabilities", "external_capabilities_not_granted", "files", "file_hashes", "release", "superseded_release", "deprecation", "created_at", "updated_at"],
  "properties": {
    "$schema": {"type": "string"}, "schema_version": {"const": "1.0.0"},
    "family_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}, "family_title": {"type": "string", "minLength": 1},
    "owning_environment": {"type": "string", "minLength": 1},
    "publisher": {"type": "object", "additionalProperties": false, "required": ["owner", "repository"], "properties": {"owner": {"type": "string"}, "repository": {"type": "string"}}},
    "family_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "lifecycle_state": {"enum": ["experimental", "stable", "deprecated", "retired"]},
    "purpose": {"type": "string", "minLength": 1}, "nonpurpose": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "parent": {"type": ["object", "null"]},
    "compatibility": {"type": "object", "additionalProperties": false, "required": ["genesis", "communications"], "properties": {"genesis": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "communications": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "supported_runtime_families": {"type": "array", "minItems": 1, "items": {"enum": ["neutral", "codex", "gemini", "claude"]}},
    "input_types": {"type": "array", "items": {"type": "string"}}, "output_types": {"type": "array", "items": {"type": "string"}}, "required_provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tools": {"type": "object", "additionalProperties": false, "required": ["required", "optional"], "properties": {"required": {"type": "array", "items": {"type": "string"}}, "optional": {"type": "array", "items": {"type": "string"}}}},
    "declared_capabilities": {"type": "array", "items": {"type": "string"}}, "external_capabilities_not_granted": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "files": {"type": "object", "additionalProperties": false, "required": ["knowledge", "playbook", "boundaries", "tools", "evaluation", "examples"], "properties": {"knowledge": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "playbook": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "tools": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evaluation": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "examples": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "file_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "release": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["tag", "tag_object", "tag_target", "package_digest"], "properties": {"tag": {"type": "string", "pattern": "^blueprints-v[0-9]+\\.[0-9]+\\.[0-9]+$"}, "tag_object": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{40}$"}, {"const": "resolve-from-annotated-tag"}]}, "tag_target": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{40}$"}, {"const": "resolve-from-annotated-tag"}]}, "package_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}]},
    "superseded_release": {"type": ["string", "null"]}, "deprecation": {"type": ["object", "null"]},
    "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}
  }
}
